!
! Interface Configuration
!
{% if loopback_interfaces %}
{% for interface in loopback_interfaces %}
interface {{ interface.name }}
   {% if interface.description %}
   description {{ interface.description }}
   {% endif %}
   {% if interface.ip_address %}
   ip address {{ interface.ip_address }}
   {% endif %}
!
{% endfor %}
{% endif %}
{% for interface in interfaces %}
interface {{ interface.name }}
   {% if interface.description %}
   description {{ interface.description }}
   {% endif %}
   {% if interface.mode == 'access' %}
   switchport mode access
   switchport access vlan {{ interface.vlan }}
   {% if interface.spanning_tree_portfast %}
   spanning-tree portfast
   {% endif %}
   {% elif interface.mode == 'trunk' %}
   switchport mode trunk
   {% if interface.allowed_vlans %}
   switchport trunk allowed vlan {{ interface.allowed_vlans }}
   {% endif %}
   {% if interface.native_vlan %}
   switchport trunk native vlan {{ interface.native_vlan }}
   {% endif %}
   {% elif interface.mode == 'routed' %}
   no switchport
   {% if interface.ip_address %}
   ip address {{ interface.ip_address }}
   {% endif %}
   {% endif %}
   {% if interface.enabled is defined and not interface.enabled %}
   shutdown
   {% else %}
   no shutdown
   {% endif %}
!
{% endfor %}
