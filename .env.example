# Kármán Web Interface Configuration
# Copy this file to .env and update values as needed

# Flask Secret Key (generate with: python3 -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your-secret-key-here

# Flask Environment (development or production)
FLASK_ENV=development

# Server Configuration
WORKERS=4
BIND_ADDRESS=0.0.0.0:5000
LOG_LEVEL=info

# Database Configuration
DB_PATH=custom-cvp.db

# Session Configuration
SESSION_TIMEOUT_HOURS=8

# Upload Configuration
MAX_CONTENT_LENGTH=16777216  # 16MB in bytes

# Optional: CVP Integration
CVP_HOST=cvp.example.com
CVP_USERNAME=admin
CVP_PASSWORD=

# Optional: Default Device Credentials
DEFAULT_DEVICE_USERNAME=admin
DEFAULT_DEVICE_PASSWORD=

# Optional: Git Integration
GIT_ENABLED=false
GIT_REPOSITORY=
GIT_BRANCH=main

# Optional: LDAP/Active Directory
LDAP_ENABLED=false
LDAP_SERVER=ldap://ldap.example.com
LDAP_BASE_DN=dc=example,dc=com

# User Authentication & Email Notifications
EMAIL_ENABLED=false  # Set to true to enable email notifications for access requests
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true
FROM_EMAIL=noreply@custom-cvp.local
ADMIN_EMAIL=admin@example.com  # Email to receive access request notifications

# Security Settings
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=30
SESSION_LIFETIME_HOURS=8
PASSWORD_MIN_LENGTH=8

# Optional: Monitoring
ENABLE_METRICS=false
PROMETHEUS_PORT=9090
