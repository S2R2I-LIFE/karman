# Simple, working Dockerfile
FROM python:3.11-slim

WORKDIR /app

# Install dependencies
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

# Copy and install Python requirements
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application
COPY . .

# Fix any line ending issues and make scripts executable
RUN apt-get update && apt-get install -y dos2unix && \
    find . -type f -name "*.sh" -exec dos2unix {} \; && \
    find . -type f -name "*.sh" -exec chmod +x {} \; && \
    apt-get remove -y dos2unix && \
    apt-get autoremove -y && \
    rm -rf /var/lib/apt/lists/*

# Create directories
RUN mkdir -p /app/data /app/logs /app/output/generated-configs

# Expose port
EXPOSE 5000

# Simple entrypoint
ENTRYPOINT ["/app/docker-entrypoint.sh"]

# Run application
CMD ["python", "-m", "gunicorn", "--bind", "0.0.0.0:5000", "--workers", "2", "--timeout", "120", "web.app:app"]
